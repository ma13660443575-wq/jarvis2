# 复制为 .env 后填写（可选的 key 留空即可，功能会自动降级）

# ===== LLM（DeepSeek，OpenAI 兼容协议 · 降级后端）=====
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 阿里云百炼 DashScope（LLM 首选后端 + sambert TTS + qwen-audio ASR）=====
# 填 DASHSCOPE_API_KEY 后：LLM 优先走 qwen 系列，TTS 走 sambert 音色，ASR 走 qwen-audio 流式。
# 留空则自动降级：LLM→DeepSeek→Mock；TTS→Edge；ASR→本地 sherpa-onnx。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# LLM 模型列表（设置页可选）与默认模型
DASHSCOPE_LLM_MODELS=qwen-max,qwen-plus,qwen-turbo,qwen-long
DASHSCOPE_DEFAULT_LLM_MODEL=qwen-plus
# TTS 音色列表（sambert 全音色，默认 zhide 知德·沉稳男声）与 ASR 模型
DASHSCOPE_TTS_VOICES=sambert-zhide-v1,sambert-zhida-v1,sambert-zhishu-v1,sambert-zhiyue-v1,sambert-eva-v1
DASHSCOPE_TTS_MODEL=sambert-zhide-v1
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming

# ===== 知识底座 =====
VAULT_PATH=./data/vault
PORT=8100

# 向量检索开关（false=离线优先，关键词 RAG 兜底，不联网下载向量模型）
VECTOR_ENABLED=true

# ===== Edge 神经语音（TTS 唯一后端方案，免费无需 key）=====
# 英文 → en-GB-RyanNeural（英式沉稳男声，电影 JARVIS 腔调）
# 中文 → zh-CN-YunjianNeural（中文沉稳男声）
# TTS_EDGE_ENABLED=false 可关闭；关闭后前端回退本地浏览器语音
TTS_EDGE_ENABLED=true
TTS_VOICE_EN=en-GB-RyanNeural
TTS_VOICE_ZH=zh-CN-YunjianNeural
TTS_RATE=-8%
TTS_RETRIES=3

# ===== 本地语音引擎（sherpa-onnx 离线 ASR，默认，首启自动下载模型，无需任何 key）=====
# VOICE_ENGINE=local → 本地离线识别（默认，快、准、免费）
# VOICE_ENGINE=volcano → 回退火山 bigmodel 在线识别（需火山 key）
VOICE_ENGINE=local
# 模型目录（默认 dev=models/，frozen=%APPDATA%\JARVIS2\models）
# SHERPA_MODEL_DIR=

# ===== 火山引擎 · 豆包语音（仅 VOICE_ENGINE=volcano 时作为 ASR 回退需要）=====
# 鉴权二选一，勿混用：
#   新版：填 VOLCANO_API_KEY（→ X-Api-Key）
#   旧版：填 VOLCANO_APP_ID + VOLCANO_ACCESS_TOKEN（→ X-Api-Access-Key，无需拼任何后缀）
# VOLCANO_API_KEY=
# VOLCANO_APP_ID=
# VOLCANO_ACCESS_TOKEN=
# VOLCANO_SECRET_KEY=
# VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCANO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLCANO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# ===== 全局后台唤醒 agent（jarvis2-wake-agent 独立常驻进程）=====
WAKE_ENABLED=true
WAKE_WORDS=jarvis,贾维斯
WAKE_AGENT_PORT=8123
WAKE_AGENT_AUTOSTART=true

# ===== 感官（可选）=====
# WEATHER_API_KEY=
# RSS_FEEDS=
# PLAYWRIGHT_ENABLED=false

# ===== 手机通知桥（预留）=====
# NOTIFY_NTFY_TOPIC=
# NOTIFY_SERVERCHAN_KEY=
# NOTIFY_TG_BOT_TOKEN=
# NOTIFY_TG_CHAT_ID=

# ===== 例行简报时间 =====
BRIEF_TIME=08:30
