{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS2",
  "version": "0.1.0",
  "identifier": "com.jarvis2.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "JARVIS",
        "url": "index.html",
        "width": 90,
        "height": 149,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/jarvis2-backend", "binaries/jarvis2-wake-agent"]
  }
}
